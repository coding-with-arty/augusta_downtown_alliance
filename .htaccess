# ===================================================================
# .htaccess | Local Development Version (XAMPP)
# ===================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ------------------------------------------------------
    # CLEAN URLS (remove .html and add trailing slash)
    # ------------------------------------------------------

    # Serve existing .html files without extension
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

    # Redirect direct .html requests → clean URL
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ %1/ [R=302,L]

    # Add trailing slash if missing
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
    RewriteRule ^(.*)$ $1/ [R=302,L]

    # ------------------------------------------------------
    # DISABLED FOR LOCAL DEV (HTTPS + WWW redirects)
    # ------------------------------------------------------
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

</IfModule>

# ------------------------------------------------------
# SECURITY: Protect sensitive files (Apache 2.4 syntax)
# ------------------------------------------------------

# Block .env
<Files ".env">
    Require all denied
</Files>

# Block PHPMailer, vendor, logs, configs, etc.
<FilesMatch "\.(env|ini|log|sh|sql|bak|config|dist)$">
    Require all denied
</FilesMatch>

# Block vendor folder (Apache 2.4 compatible)
RedirectMatch 403 ^/vendor/.*

# Disable directory listing
Options -Indexes

# ------------------------------------------------------
# OPTIONAL FOR DEV: Commented out caching + compression
# ------------------------------------------------------

# <IfModule mod_expires.c>
#     ExpiresActive On
# </IfModule>

# <IfModule mod_deflate.c>
#     AddOutputFilterByType DEFLATE text/html text/css application/javascript
# </IfModule>

# ------------------------------------------------------
# Error pages (local dev)
# ------------------------------------------------------
ErrorDocument 404 /error.html
ErrorDocument 500 /error.html

